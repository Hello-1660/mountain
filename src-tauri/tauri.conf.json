{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mountain 启动器",
  "version": "1.3.0",
  "identifier": "com.mountain.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dock",
        "title": "便捷启动",
        "width": 400,
        "height": 136,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "alwaysOnBottom": true
      },
      {
        "label": "library",
        "title": "全部应用",
        "width": 1058,
        "height": 736,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0b0e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "River Side",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
